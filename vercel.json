{
    "services": {
        "vite_frontend": {
            "root": "frontend/"
        },
        "flask_backend": {
            "root": "backend/",
            "entrypoint": "main:app"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": { "service": "flask_backend" }
        },
        {
            "source": "/(.*)",
            "destination": { "service": "vite_frontend" }
        }
    ]
}